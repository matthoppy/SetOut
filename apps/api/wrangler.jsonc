{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // One Worker serves the API and both apps, so they ship together and can
  // never disagree about a calculation.
  "name": "setout",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  },
  // The built designer and workspace. Only /api goes to the Worker's code;
  // everything else is served as a file, falling back to the workspace page.
  "assets": {
    "directory": "../../dist/site",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // The top level is local development and tests only. Nothing deploys from
  // it: a deploy must name staging or production.
  "vars": {
    "ENVIRONMENT": "local",
    "COMMIT": "local"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "setout-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Drawings and photos. One bucket per environment, one folder per company
  // inside it. The deployed buckets are created in the EU by the deploy script.
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "setout-local-files" }],

  "env": {
    "staging": {
      "vars": {
        "ENVIRONMENT": "staging",
        "COMMIT": "unknown"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "setout-staging",
          "database_id": "cbdb554c-c41f-4bb1-aa16-c94a013dc617",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "FILES", "bucket_name": "setout-staging-files", "jurisdiction": "eu" }
      ]
    },
    "production": {
      "vars": {
        "ENVIRONMENT": "production",
        "COMMIT": "unknown"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "setout-production",
          "database_id": "faee68c8-6ecf-4884-b724-e80f98672d50",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "FILES", "bucket_name": "setout-production-files", "jurisdiction": "eu" }
      ]
    }
  }
}
