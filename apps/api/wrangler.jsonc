{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // One Worker serves the API and both apps, so they ship together and can
  // never disagree about a calculation.
  "name": "setout",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  },
  // The built designer and workspace. Their fingerprinted scripts and styles
  // are served straight from storage. Everything else goes through the
  // Worker's code first: the API, and every page, so that each page gets the
  // right app for its address and the right rules about who may frame it.
  "assets": {
    "directory": "../../dist/site",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*", "!/assets/*", "!/designer/assets/*"]
  },

  // The top level is local development and tests only. Nothing deploys from
  // it: a deploy must name staging or production.
  "vars": {
    "ENVIRONMENT": "local",
    "COMMIT": "local",
    // One address locally, so both apps are served from it by path.
    "DESIGNER_HOST": "",
    "APP_HOST": "",
    // SetOut's own site. With no address of its own it is served under /site/.
    "SITE_HOST": "",
    // The address emails are sent from. Empty means nothing is emailed.
    "EMAIL_FROM": "",
    // Where a get-started enquiry from the site is emailed. Empty means it
    // is saved and nobody is emailed.
    "SITE_NOTIFY_EMAIL": "",
    // The bot check widget's public key for the site's form. Empty means the
    // form has no bot check.
    "SITE_TURNSTILE_SITE_KEY": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "setout-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Drawings and photos. One bucket per environment, one folder per company
  // inside it. The deployed buckets are created in the EU by the deploy script.
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "setout-local-files" }],

  "env": {
    "staging": {
      // Staging keeps its workers.dev name as well, which serves both apps by
      // path and is what the deploy's health check asks.
      "workers_dev": true,
      "routes": [
        { "pattern": "designer-staging.setoutglass.com", "custom_domain": true },
        { "pattern": "app-staging.setoutglass.com", "custom_domain": true }
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        "COMMIT": "unknown",
        "DESIGNER_HOST": "designer-staging.setoutglass.com",
        "APP_HOST": "app-staging.setoutglass.com",
        // Staging's site has no address of its own. It is under /site/ on the
        // workers.dev name.
        "SITE_HOST": "",
        // setoutglass.com is a verified sending domain in Resend. The mail key
        // is a secret on the Worker, set in Cloudflare, never here.
        "EMAIL_FROM": "hello@setoutglass.com",
        // Resend's test inbox, so trying the form never lands in a real one.
        "SITE_NOTIFY_EMAIL": "delivered@resend.dev",
        // To be set: see docs/deploying.md.
        "SITE_TURNSTILE_SITE_KEY": ""
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "setout-staging",
          "database_id": "cbdb554c-c41f-4bb1-aa16-c94a013dc617",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "FILES", "bucket_name": "setout-staging-files", "jurisdiction": "eu" }
      ]
    },
    "production": {
      // Production answers on its two addresses and nowhere else. The embed
      // script's address, https://designer.setoutglass.com/embed.js, is
      // permanent once a company has pasted it into its website.
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        { "pattern": "designer.setoutglass.com", "custom_domain": true },
        { "pattern": "app.setoutglass.com", "custom_domain": true }
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "COMMIT": "unknown",
        "DESIGNER_HOST": "designer.setoutglass.com",
        "APP_HOST": "app.setoutglass.com",
        // The site's address, without www. It does nothing until
        // setoutglass.com and www.setoutglass.com are added to the routes
        // above, which is Matt's call: see docs/deploying.md.
        "SITE_HOST": "setoutglass.com",
        "EMAIL_FROM": "hello@setoutglass.com",
        // Enquiries go to Custom Showers' sales inbox (Matt, 12 November 2026).
        // The bot check's key is still to be set: see docs/deploying.md.
        "SITE_NOTIFY_EMAIL": "sales@customshowers.uk",
        "SITE_TURNSTILE_SITE_KEY": ""
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "setout-production",
          "database_id": "faee68c8-6ecf-4884-b724-e80f98672d50",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "FILES", "bucket_name": "setout-production-files", "jurisdiction": "eu" }
      ]
    }
  }
}
