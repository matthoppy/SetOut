# Sent with the files served straight from storage: scripts, styles, pictures.
# Pages go through the Worker, which sets its own headers for each address,
# including who may frame the designer. See apps/api/src/site.ts.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

# The designer is made to be shown in a frame on a company's own website.
/designer/*
  ! X-Frame-Options

# CRL's product photos (scripts/crl-photos.mjs). Each is named by a fingerprint
# of the photo, so a changed photo is a new file and these never go stale.
/designer/assets/crl/*
  Cache-Control: public, max-age=31536000, immutable
